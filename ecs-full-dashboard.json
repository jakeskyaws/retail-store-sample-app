{
  "dashboard": {
    "title": "ECS Services - Full Dashboard",
    "panels": [
      {
        "title": "Service Status",
        "type": "stat",
        "targets": [{"expr": "up", "legendFormat": "{{job}}"}],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "title": "JVM Heap Usage %",
        "type": "stat", 
        "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (job) * 100 / sum(jvm_memory_max_bytes{area=\"heap\"}) by (job)", "legendFormat": "{{job}}"}],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "title": "HTTP Request Rate",
        "type": "timeseries",
        "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[5m])) by (job)", "legendFormat": "{{job}}"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "title": "JVM Memory Usage",
        "type": "timeseries",
        "targets": [
          {"expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (job)", "legendFormat": "{{job}} - heap"},
          {"expr": "sum(jvm_memory_used_bytes{area=\"nonheap\"}) by (job)", "legendFormat": "{{job}} - nonheap"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "title": "HTTP Response Times",
        "type": "timeseries",
        "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (job, le))", "legendFormat": "{{job}} - 95th percentile"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "title": "GC Collections",
        "type": "timeseries",
        "targets": [{"expr": "rate(jvm_gc_pause_seconds_count[5m])", "legendFormat": "{{job}} - {{action}}"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "30s"
  }
}